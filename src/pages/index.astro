---
import Base from '../layouts/Base.astro';
import { nav } from '../config/site';

// Short descriptions for the "explore" links on the landing page.
const explore = [
  { label: 'The Journey', href: '/about', note: 'College to founding-team engineer — and the choices in between.' },
  { label: 'The Work', href: '/work', note: 'A few systems, told as problem → decision → outcome.' },
  { label: 'Writing', href: '/blog', note: 'Notes and deep-dives on building AI in production, as they come.' },
  { label: 'Résumé', href: '/resume.pdf', note: 'The one-page version.', external: true },
];
---

<Base>
  <main>
    <section class="hero container">
      <p class="eyebrow">AI Engineer · Bengaluru</p>

      <h1 class="hero-title">
        I build applied AI systems for real industry problems.
      </h1>

      <p class="lead">
        I'm one of the early engineers on <span class="nowrap">aiRA</span> — Capillary's agentic AI
        platform — where I've gone from Product Analyst to SDE-2 in two years. I care more about the
        problem than the framework: reasoning from first principles, and owning systems from design
        through production.
      </p>

      <p class="note muted">
        This site is the long version — the journey, the work, and what I'm figuring out as I go.
      </p>

      <nav class="explore" aria-label="Explore">
        {
          explore.map((item) => (
            <a
              class="explore-item"
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener' : undefined}
            >
              <span class="explore-label">
                {item.label}
                <span class="arrow" aria-hidden="true">→</span>
              </span>
              <span class="explore-note">{item.note}</span>
            </a>
          ))
        }
      </nav>
    </section>
  </main>
</Base>

<style>
  .hero {
    padding-top: clamp(3.5rem, 12vh, 7rem);
    padding-bottom: 2rem;
  }
  .hero-title {
    font-size: clamp(2.35rem, 6vw, 3.6rem);
    max-width: 15ch;
    margin-top: 1.1rem;
  }
  .lead {
    margin-top: 1.6rem;
    max-width: 42ch;
  }
  .note {
    margin-top: 1.1rem;
    font-size: 1rem;
    max-width: 46ch;
  }
  .nowrap { white-space: nowrap; }

  .explore {
    margin-top: 3.25rem;
    border-top: 1px solid var(--border);
  }
  .explore-item {
    display: block;
    padding: 1.15rem 0.25rem;
    border-bottom: 1px solid var(--border);
    transition: padding-left 0.2s ease, background-color 0.2s ease;
  }
  .explore-item:hover {
    padding-left: 0.75rem;
  }
  .explore-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 480;
    letter-spacing: -0.01em;
  }
  .explore-item:hover .explore-label {
    color: var(--accent);
  }
  .arrow {
    font-family: var(--font-sans);
    transition: transform 0.2s ease;
  }
  .explore-item:hover .arrow {
    transform: translateX(4px);
  }
  .explore-note {
    display: block;
    margin-top: 0.2rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
