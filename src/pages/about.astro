const principles = [
  {
    h: 'Problems before technologies',
    p: 'The question is never “how do I use the newest framework?” It’s “what’s the simplest system that solves this well?” Sometimes that’s an LLM. Sometimes it’s SQL. Sometimes it’s deleting code.',
  },
  {
    h: 'Own it end to end',
    p: 'A feature isn’t finished when it compiles. It’s finished when it survives production and the next engineer can understand it. Ownership is a mindset, not an assignment.',
  },
  {
    h: 'Reason from first principles',
    p: 'I’d rather understand why a system exists, what constrained it, and what breaks it than copy an architecture because it’s popular.',
  },
  {
    h: 'Optimize for impact, not output',
    p: 'Lines of code aren’t achievements. Problems solved are. Every decision should answer: what measurably got better because this exists?',
  },
  {
    h: 'Build systems, not features',
    p: 'Features disappear; systems compound. The best work leaves the next problem easier to solve.',
  },
  {
    h: 'Simplicity is the advantage',
    p: 'Clarity over cleverness. Simple usually costs more understanding up front and far less pain forever.',
  },
